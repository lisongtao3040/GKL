<Window x:Class="WebCameraByAforge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aforge ="clr-namespace:AForge.Controls;assembly=AForge.Controls" 
        xmlns:wfi ="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"  
        Title="MainWindow" Height="768" Width="1024" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Label  HorizontalContentAlignment="Right" Content="摄像头" Margin="4,0" />
            <ComboBox  x:Name="comboCamera" SelectionChanged="comboCamera_SelectionChanged" Width="200"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Label  HorizontalContentAlignment="Right" Content="分辨率" Margin="4,0" />
            <ComboBox  x:Name="comboResolution" SelectionChanged="comboResolution_SelectionChanged"  Width="200"/>
        </StackPanel>    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"  VerticalAlignment="Center">
            <Button Content="检测" x:Name="btnDetectCam"  Click="btnDetectCam_Click" Width="100" />
            <Button Content="确定" x:Name="btnSelectCam"   Click="btnSelectCam_Click" Width="100"/>
        </StackPanel>
        <wfi:WindowsFormsHost Grid.Row="1" Grid.ColumnSpan="3">
            <aforge:VideoSourcePlayer x:Name="videoSourcePlayer1" Width="300" Height="360">
            </aforge:VideoSourcePlayer>
        </wfi:WindowsFormsHost>

        <Button Grid.Column="1" Grid.Row="2"   x:Name="btnCap" Content="拍照" Height="35" Width="60" VerticalAlignment="Bottom" Click="btnCap_Click" ></Button>
        <Button Grid.Column="2" Grid.Row="2" x:Name="btnStop" Content="停止" Height="35" Width="60" VerticalAlignment="Bottom" Click="btnStop_Click" ></Button>
        <Button Grid.Column="0" Grid.Row="2" x:Name="btnStart" Content="开始" Height="35" Width="60" VerticalAlignment="Bottom" Click="btnStart_Click" ></Button>

    </Grid>
</Window>
