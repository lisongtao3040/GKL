<Window x:Class="WebCameraByWPFMediaKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:wpfMedia="clr-namespace:WPFMediaKit.DirectShow.Controls;assembly=WPFMediaKit"
        Title="MainWindow" Height="350" Width="525"  Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <wpfMedia:VideoCaptureElement Name="vce" EnableSampleGrabbing="True" Grid.ColumnSpan="3" >

        </wpfMedia:VideoCaptureElement>
       
        <Button Grid.Column="1"  x:Name="btnCap" Content="拍照" Height="35" Width="60" VerticalAlignment="Bottom" Click="btnCap_Click" ></Button>
        <Button Grid.Column="2" x:Name="btnStop" Content="停止" Height="35" Width="60" VerticalAlignment="Bottom" Click="btnStop_Click" ></Button>
        <Button Grid.Column="0" x:Name="btnStart" Content="开始" Height="35" Width="60" VerticalAlignment="Bottom" Click="btnStart_Click" ></Button>

    </Grid>
</Window>
